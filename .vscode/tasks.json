{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Avvia Sito Locale (Vite)",
      "type": "shell",
      "command": "npm run dev",
      "isBackground": true,
      "problemMatcher": {
        "owner": "vite",
        "pattern": {
          "regexp": "^$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "VITE v.* ready in",
          "endsPattern": "Local:\\s+http://localhost:3000"
        }
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "Installa Dipendenze (npm install)",
      "type": "shell",
      "command": "npm install",
      "problemMatcher": []
    },
    {
      "label": "Build di Produzione (npm run build)",
      "type": "shell",
      "command": "npm run build",
      "problemMatcher": []
    }
  ]
}
